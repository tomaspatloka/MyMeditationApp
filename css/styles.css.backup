/* Reset & Base */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  /* Colors */
  --bg-primary: #1a1a2e;
  --bg-secondary: #16213e;
  --bg-card: #0f1624;
  --text-primary: #eee;
  --text-secondary: #bbb;
  --accent-primary: #667eea;
  --accent-secondary: #764ba2;
  --accent-glow: rgba(102, 126, 234, 0.3);
  --success: #4ade80;
  --danger: #ef4444;
  --warning: #fbbf24;

  /* Spacing - kompaktnější pro mobil */
  --spacing-xs: 0.25rem;
  --spacing-sm: 0.5rem;
  --spacing-md: 0.75rem;
  --spacing-lg: 1rem;
  --spacing-xl: 1.5rem;

  /* Border radius */
  --radius-sm: 6px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-full: 50%;

  /* Typography */
  --font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
}

html {
  font-size: 16px;
  -webkit-tap-highlight-color: transparent;
}

body {
  font-family: var(--font-family);
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* App Container */
.app-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  max-width: 100%;
  margin: 0 auto;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Header - kompaktnější */
.app-header {
  text-align: center;
  padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-xs);
  background: linear-gradient(180deg, var(--bg-secondary) 0%, transparent 100%);
}

.app-header h1 {
  font-size: 1.25rem;
  font-weight: 600;
  background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 0;
}

.tagline {
  display: none; /* Skrýt pro úsporu místa */
}

/* Navigation - kompaktnější */
.main-nav {
  display: flex;
  gap: 0.25rem;
  padding: 0.4rem;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  margin: 0 var(--spacing-sm) var(--spacing-sm);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.nav-btn {
  flex: 1;
  min-width: 60px;
  padding: 0.5rem 0.3rem;
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-size: 0.75rem;
  font-weight: 500;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all 0.3s ease;
  white-space: nowrap;
}

.nav-btn.active {
  background: var(--accent-primary);
  color: white;
  box-shadow: 0 4px 15px var(--accent-glow);
}

.nav-btn:not(.active):active {
  background: rgba(255, 255, 255, 0.05);
}

/* Main Content */
.main-content {
  flex: 1;
  padding: 0 var(--spacing-sm) var(--spacing-lg);
}

.view {
  display: none;
  animation: fadeIn 0.3s ease;
}

.view.active {
  display: block;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Buttons */
.btn {
  padding: var(--spacing-sm) var(--spacing-md);
  border: none;
  border-radius: var(--radius-md);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  min-width: 100px;
  touch-action: manipulation;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
  color: white;
  box-shadow: 0 4px 20px var(--accent-glow);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2px 10px var(--accent-glow);
}

.btn-secondary {
  background: var(--bg-secondary);
  color: var(--text-primary);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.btn-secondary:active {
  background: var(--bg-card);
}

.btn-danger {
  background: var(--danger);
  color: white;
}

.btn-danger:active {
  background: #dc2626;
}

.hidden {
  display: none !important;
}

/* Duration Selector */
.duration-selector {
  display: flex;
  gap: var(--spacing-xs);
  justify-content: center;
  margin: var(--spacing-sm) 0;
  flex-wrap: wrap;
}

.duration-btn {
  padding: 0.4rem var(--spacing-sm);
  background: var(--bg-secondary);
  border: 2px solid transparent;
  color: var(--text-secondary);
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  min-width: 55px;
}

.duration-btn.active {
  border-color: var(--accent-primary);
  color: var(--accent-primary);
  background: rgba(102, 126, 234, 0.1);
}

.duration-btn:active {
  transform: scale(0.95);
}

/* Audio Controls */
.audio-controls {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--bg-secondary);
  border-radius: var(--radius-lg);
}

.audio-controls h3 {
  font-size: 0.9rem;
  margin-bottom: var(--spacing-sm);
  color: var(--text-primary);
}

.audio-selector {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.audio-option {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm);
  background: var(--bg-card);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 0.85rem;
}

.audio-option:has(input:checked) {
  background: rgba(102, 126, 234, 0.2);
  border: 2px solid var(--accent-primary);
}

.audio-option input[type="radio"] {
  margin-right: var(--spacing-sm);
  accent-color: var(--accent-primary);
}

.volume-control {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.volume-control label {
  min-width: 80px;
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.volume-control input[type="range"] {
  flex: 1;
  height: 6px;
  border-radius: 3px;
  background: var(--bg-card);
  outline: none;
  -webkit-appearance: none;
}

.volume-control input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--accent-primary);
  cursor: pointer;
  box-shadow: 0 2px 8px var(--accent-glow);
}

.volume-control input[type="range"]::-moz-range-thumb {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--accent-primary);
  cursor: pointer;
  border: none;
  box-shadow: 0 2px 8px var(--accent-glow);
}

#volumeValue {
  min-width: 45px;
  text-align: right;
  font-weight: 600;
  color: var(--accent-primary);
}

/* Stats View */
.stats-container {
  padding: var(--spacing-sm);
}

.stats-container h2 {
  font-size: 1.2rem;
  margin-bottom: var(--spacing-md);
  text-align: center;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.stat-card {
  background: var(--bg-secondary);
  padding: var(--spacing-md);
  border-radius: var(--radius-lg);
  text-align: center;
  transition: transform 0.3s ease;
}

.stat-card:active {
  transform: scale(0.98);
}

.stat-icon {
  font-size: 2rem;
  margin-bottom: var(--spacing-xs);
}

.stat-value {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--accent-primary);
  margin-bottom: var(--spacing-xs);
}

.stat-label {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.progress-section {
  background: var(--bg-secondary);
  padding: var(--spacing-md);
  border-radius: var(--radius-lg);
}

.progress-section h3 {
  font-size: 1rem;
  margin-bottom: var(--spacing-sm);
  text-align: center;
}

.progress-badge {
  text-align: center;
}

.badge-icon {
  font-size: 3rem;
  margin-bottom: var(--spacing-xs);
}

.badge-name {
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--accent-primary);
  margin-bottom: var(--spacing-xs);
}

.badge-desc {
  color: var(--text-secondary);
  font-size: 0.8rem;
}

/* Settings View */
.settings-container {
  padding: var(--spacing-sm);
}

.settings-container h2 {
  font-size: 1.2rem;
  margin-bottom: var(--spacing-md);
}

.settings-group {
  background: var(--bg-secondary);
  padding: var(--spacing-md);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-sm);
}

.settings-group label {
  display: block;
  color: var(--text-secondary);
  font-size: 0.9rem;
  margin-bottom: var(--spacing-sm);
  font-weight: 500;
}

.settings-group select {
  width: 100%;
  padding: var(--spacing-sm);
  background: var(--bg-card);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 0.9rem;
  cursor: pointer;
}

.settings-group input[type="checkbox"] {
  margin-right: var(--spacing-sm);
  accent-color: var(--accent-primary);
  width: 20px;
  height: 20px;
  cursor: pointer;
}

.settings-group label:has(input[type="checkbox"]) {
  display: flex;
  align-items: center;
  cursor: pointer;
  color: var(--text-primary);
  margin-bottom: 0;
}

.settings-group h3 {
  margin-bottom: var(--spacing-sm);
  font-size: 1rem;
}

.info-text {
  color: var(--text-secondary);
  font-size: 0.75rem;
  line-height: 1.4;
  margin-bottom: var(--spacing-xs);
}

/* Responsive Design */
@media (min-width: 768px) {
  .app-container {
    max-width: 600px;
  }

  .stats-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* iOS specific fixes */
@supports (-webkit-touch-callout: none) {
  body {
    min-height: -webkit-fill-available;
  }
}

/* Animations for better UX */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
